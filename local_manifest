<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!-- Remotes -->
    <remote
        name="github"
        fetch="https://github.com/" />

    <remote
        name="codeberg"
        fetch="https://codeberg.org/" />

    <!-- Device Tree -->
    <project
        name="LineageOS/android_device_motorola_manaus"
        path="device/motorola/manaus"
        remote="github" />

    <!-- Common Device Tree -->
    <project
        name="moto-mt6879/android_device_motorola_mt6879-common"
        path="device/motorola/mt6879-common"
        remote="github" />

    <!-- Vendor -->
    <project
        name="rexix01/vendor_motorola_manaus"
        path="vendor/motorola/manaus"
        remote="codeberg" />

    <!-- Kernel -->
    <project
        name="moto-mt6879/android_kernel_motorola_mt6879"
        path="kernel/motorola/mt6879"
        remote="github" />

    <!-- MediaTek Hardware -->
    <project
        name="moto-mt6879/hardware_mediatek"
        path="hardware/mediatek"
        remote="github" />

    <!-- Motorola Hardware -->
    <project
        name="moto-mt6879/hardware_motorola"
        path="hardware/motorola"
        remote="github" />

    <!-- MediaTek SEPolicy -->
    <project
        name="moto-mt6879/device_mediatek_sepolicy_vndr"
        path="device/mediatek/sepolicy_vndr"
        remote="github" />

</manifest>
